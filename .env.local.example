# Configuration locale du site Hoa Ly (copier en .env.local)

# Base PostgreSQL (facultative). Vide = catalogue en fichiers dans data/.
# Voir deploy/GUIDE-BDD.md. Exemple : postgresql://utilisateur:motdepasse@127.0.0.1:5432/hoaly
DATABASE_URL=
# Chiffrement : auto (défaut) | require | verify | disable
DATABASE_SSL=auto

# Auth admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=une_phrase_de_passe_de_15_caracteres_minimum
SESSION_SECRET=chaine_aleatoire_de_32_caracteres_minimum

# Google (facultatif : avis clients sur l'accueil)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Adresse publique du site
NEXT_PUBLIC_APP_URL=http://localhost:3000
