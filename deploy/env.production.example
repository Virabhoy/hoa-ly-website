# Configuration du site sur le serveur (copiée vers /var/www/hoaly/.env.local par install.sh).
# Ne jamais envoyer ce fichier rempli par e-mail ni le mettre dans git.

# Adresse publique du site (avec https, sans / final)
NEXT_PUBLIC_APP_URL=https://__DOMAIN__

# Dossier du catalogue sur le serveur (hors du dossier du site, sauvegardé chaque nuit)
HOALY_DATA_DIR=/var/lib/hoaly

# Accès à l'administration
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_PASSWORD=__ADMIN_PASSWORD__
SESSION_SECRET=__SESSION_SECRET__

# Base PostgreSQL (facultative). Vide = catalogue en fichiers dans HOALY_DATA_DIR.
# Voir deploy/GUIDE-BDD.md : PostgreSQL sur le VPS, IONOS Cloud ou Supabase.
DATABASE_URL=
# auto (défaut) | require | verify | disable
DATABASE_SSL=auto

# Avis Google (facultatif)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
